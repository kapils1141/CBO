{
  "heap": [
    {
      "name": "ClientHandler",
      "type": "ClientHandler",
      "config": {
        "hostnameVerifier": "ALLOW_ALL",
        "connectionTimeout": "10 seconds",
        "soTimeout": "30 seconds"
      }
    },
    {
      "name": "SystemAndEnvSecretStore",
      "type": "SystemAndEnvSecretStore"
    },
    {
      "name": "AmService-CBOAM",
      "type": "AmService",
      "config": {
        "url": "http://openam.lloyds.com:8080/openam",
        "realm": "/commercial-banking",
        "agent": {
          "username": "ig-agent",
          "passwordSecretId": "agent.secret.id"
        },
        "secretsProvider": "SystemAndEnvSecretStore",
        "sessionCache": {
          "enabled": true,
          "maxTimeout": "3 minutes"
        }
      }
    },
    {
      "name": "AmJwkSetSecretStore",
      "type": "JwkSetSecretStore",
      "config": {
        "jwkUrl": "http://openam.lloyds.com:8080/openam/oauth2/commercial-banking/connect/jwk_uri",
        "handler": "ClientHandler",
        "secretsQueryInterval": "5 minutes"
      }
    }
  ],
  "handler": {
    "type": "Router",
    "config": {
      "directory": "${openig.configDirectory}/routes"
    }
  }
}