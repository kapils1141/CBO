{
  "name": "02-protected-app",
  "comment": "Session-protected proxy to the React app.",
  "condition": "${not find(request.uri.path, '^/api/') and not find(request.uri.path, '^/openam/')}",
  "baseURI": "http://cbonline.lloyds.com:3000",
  "heap": [],
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "type": "SingleSignOnFilter",
          "config": {
            "amService": "AmService-CBOAM",
            "failureHandler": {
              "type": "StaticResponseHandler",
              "config": {
                "status": 302,
                "reason": "Found",
                "headers": {
                  "Location": ["http://cbonline.lloyds.com:3000/PrimaryAuth"],
                  "Cache-Control": ["no-store"]
                }
              }
            }
          }
        }
      ],
      "handler": "ClientHandler"
    }
  }
}