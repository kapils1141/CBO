{
  "name": "01-am-connection",
  "comment": "AM agent pass-through.",
  "condition": "${find(request.uri.path, '^/openam/')}",
  "baseURI": "http://openam.lloyds.com:8080",
  "heap": [
    {
      "name": "AmAgentService",
      "type": "AmService",
      "config": {
        "url": "http://openam.lloyds.com:8080/openam",
        "realm": "/commercial-banking",
        "agent": {
          "username": "ig-agent",
          "passwordSecretId": "agent.secret.id"
        },
        "secretsProvider": "SystemAndEnvSecretStore"
      }
    }
  ],
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "type": "HeaderFilter",
          "config": {
            "messageType": "REQUEST",
            "remove": ["X-Forwarded-For"],
            "add": {
              "X-Forwarded-For": ["${contexts.client.remoteAddress}"]
            }
          }
        }
      ],
      "handler": "ClientHandler"
    }
  }
}