{
  "name": "03-api-gateway",
  "comment": "JWT Policy Enforcement Point for /api/* paths. Validates RS256 Bearer token via AM JWKS, injects claims as headers, sets session cookies, then proxies to Spring Boot.",
  "condition": "${find(request.uri.path, '^/api/')}",
  "baseURI": "http://host.docker.internal:8082",
  "heap": [],
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "comment": "Verify RS256 JWT signature",
          "type": "JwtValidationFilter",
          "config": {
            "jwt": "${request.headers['Authorization'][0].substring(7)}",
            "verificationSecretId": "am.rs256.verification",
            "secretsProvider": "AmJwkSetSecretStore",
            "failureHandler": {
              "type": "StaticResponseHandler",
              "config": {
                "status": 401,
                "reason": "Unauthorized",
                "headers": {
                  "Content-Type": ["application/json"],
                  "WWW-Authenticate": ["Bearer realm=\"commercial-banking\""]
                },
                "entity": "{\"error\":\"unauthorized\",\"message\":\"A valid JWT Bearer token is required\"}"
              }
            }
          }
        },
        {
          "comment": "Decode JWT and inject as headers",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "inject-jwt-headers.groovy"
          }
        }
      ],
      "handler": "ClientHandler"
    }
  }
}